# get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# verify these IDs are still live at https://openrouter.ai/models?q=free
TEXT_MODELS=meta-llama/llama-3.3-70b-instruct:free,mistralai/mistral-small-3.1-24b-instruct:free
VISION_MODELS=qwen/qwen2.5-vl-72b-instruct:free,meta-llama/llama-3.2-11b-vision-instruct:free

# shared secret clients send as X-API-Key
API_KEY=change-me

QDRANT_URL=http://qdrant:6333
COLLECTION=products

MAX_ITERATIONS=3
TOP_K=24
SHORTLIST=5
COLOUR_THRESHOLD=0.22
