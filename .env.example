# get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# free model IDs rotate; list current ones with
#   curl -s https://openrouter.ai/api/v1/models | jq -r '.data[] | select(.pricing.prompt=="0") | .id'
TEXT_MODELS=z-ai/glm-5.2:free,nvidia/nemotron-3-super-120b-a12b:free,poolside/laguna-s-2.1:free
VISION_MODELS=google/gemma-4-26b-a4b-it:free,dots-studio/dots-3-note-preview:free

# optional local fallback, tried when every OpenRouter model fails
# needs ollama running on the host: ollama pull llama3.2:3b && ollama pull qwen2.5vl:7b
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_TEXT_MODEL=
OLLAMA_VISION_MODEL=

# shared secret clients send as X-API-Key
API_KEY=change-me

QDRANT_URL=http://qdrant:6333
# required when using Qdrant Cloud (or any Qdrant instance with auth enabled)
QDRANT_API_KEY=
COLLECTION=products

MAX_ITERATIONS=3
TOP_K=24
SHORTLIST=5

# comma-separated origins allowed to call this API cross-origin, e.g. when the
# frontend is deployed as its own Vercel project: https://your-frontend.vercel.app
CORS_ORIGINS=
