# Everything in this LLM section is optional. Without it, requests are read by rules and
# results ranked by visual similarity; a vision model re-ranks them by looking at the photos.

# free key at https://openrouter.ai/keys - the free tier allows 50 requests a day, and a
# search makes one (two with LLM_PARSE on)
OPENROUTER_API_KEY=

# free model IDs rotate; list current ones with
#   curl -s https://openrouter.ai/api/v1/models | jq -r '.data[] | select(.pricing.prompt=="0") | .id'
TEXT_MODELS=qwen/qwen3.8-27b:free,nvidia/nemotron-3-super-120b-a12b:free,poolside/laguna-s-2.1:free
VISION_MODELS=google/gemma-4-26b-a4b-it:free,dots-studio/dots-3-note-preview:free

# or run models locally with ollama - no key, no limit; tried after any OpenRouter models
#   ollama pull qwen2.5:7b && ollama pull qwen2.5vl:7b
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_TEXT_MODEL=
OLLAMA_VISION_MODEL=

# also let the LLM read requests, for phrasing the rules miss ("sunnies", "office shoes");
# costs one more call per search
LLM_PARSE=false

# shared secret clients send as X-API-Key (also built into the web page)
API_KEY=change-me

# searches and embeds allowed per client per minute; 0 turns the limit off
RATE_LIMIT_PER_MINUTE=30

QDRANT_URL=http://qdrant:6333
# required when using Qdrant Cloud (or any Qdrant instance with auth enabled)
QDRANT_API_KEY=
COLLECTION=products

MAX_ITERATIONS=3
TOP_K=24
SHORTLIST=5

# comma-separated origins allowed to call this API cross-origin, e.g. when the
# frontend is deployed as its own Vercel project: https://your-frontend.vercel.app
CORS_ORIGINS=
