# sent by clients as X-API-Key, and built into the web page
API_KEY=change-me

# searches and embeds per client per minute, 0 for no limit
RATE_LIMIT_PER_MINUTE=30

QDRANT_URL=http://qdrant:6333
# only needed for a Qdrant with auth, such as Qdrant Cloud
QDRANT_API_KEY=
COLLECTION=products

MAX_ITERATIONS=3
TOP_K=24
SHORTLIST=5
