# backend API origin. Leave blank for local dev (Vite's dev-server proxy in
# vite.config.js forwards /search etc. to http://localhost:8000) or when the
# frontend and API share an origin. Set this when the frontend is deployed as
# its own Vercel project, pointing at the backend project's URL:
#   VITE_API_URL=https://your-backend.vercel.app
VITE_API_URL=

# optional: pre-fills the UI's API key field with the backend's API_KEY value,
# so visitors don't have to paste it in manually. NOT a real secret once set -
# anything VITE_-prefixed is bundled into the public JS, so anyone opening
# DevTools can read it out. Only set this if you're fine with that (e.g. a
# private/trusted-audience demo). Leave blank to require manual entry instead.
VITE_API_KEY=
